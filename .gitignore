# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# Estado de ejecucion (no reproducible / especifico de la maquina)
05_RESULTADOS/dashai_state.json

# Sistema operativo
Thumbs.db
Desktop.ini
.DS_Store

# Editores
.vscode/
*.swp
~$*

# Temporales de Office
*.tmp

# Credenciales de NotebookLM / Gemini Notebook (viven en ~/.notebooklm, nunca aqui)
.notebooklm/
storage_state.json
master_token.json
auth.json
*.cookies

# Variables de entorno con secretos — NUNCA se versionan
.env
.env.*
!.env.example

# Grabaciones de clase: pesan cientos de MB. Se versionan las transcripciones,
# no los videos. EXCEPCIÓN: archivos NOTAS y INDEX (documentación de estudio).
09_CLASES/video/
*.mp4
*.mkv
*.webm
10_GRABACIÓN_CLASES/
!10_GRABACIÓN_CLASES/**/NOTAS*.md
!10_GRABACIÓN_CLASES/**/INDEX.md
!10_GRABACIÓN_CLASES/**/METADATA.json
*.zip

# Presentaciones originales: se versiona el texto extraido, no los PDF de 20 MB
11_PRESENTACIÓN/*.pdf
